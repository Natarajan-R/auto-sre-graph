# .gitignore
# Environment variables (DO NOT COMMIT)
.env
.env.local
.env.*.local
*.env
*.env.local

# Python
__pycache__/
*.py[cod]
*.so
.pytest_cache/
.coverage
htmlcov/
.venv/
venv/
*.log
*.db
*.sqlite3

# IDE
.idea/
.vscode/
*.swp
.DS_Store

# Docker
*.container
*.image
docker-compose.override.yml

# Project specific
*.sre-*
sre_cache/
.coverage
coverage.xml
# Manuscript sources and drafting artifacts - these belong to the book repo,
# never to the public companion code repo.
session-*.md
chapter*.md
CHAPTER_*.md
*(Copy).md
static_analysis_report*.md
Log Parser.md
log_analyzer_md
