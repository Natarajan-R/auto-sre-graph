# .env.example
# Auto-SRE-Graph Environment Configuration
# Copy this file to .env and update values for your environment

# ================================
# Application Configuration
# ================================
ENVIRONMENT=DEV
APP_NAME=Auto-SRE-Graph
APP_VERSION=1.0.0
LOG_LEVEL=INFO

# ================================
# API Configuration
# ================================
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=false
API_WORKERS=4
API_TIMEOUT=60

# ================================
# Database Configuration
# ================================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DATABASE=sre_workflows
POSTGRES_USER=sre_user
POSTGRES_PASSWORD=sre_password_change_me_in_production
POSTGRES_POOL_SIZE=10
POSTGRES_MAX_OVERFLOW=20

# ================================
# Neo4j Configuration
# ================================
NEO4J_HOST=neo4j
NEO4J_PORT=7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_password_change_me
NEO4J_DATABASE=neo4j

# ================================
# Qdrant Configuration
# ================================
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION=runbooks
QDRANT_VECTOR_SIZE=1536

# ================================
# Redis Configuration
# ================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_SSL=false

# ================================
# LiteLLM Configuration
# ================================
LITELLM_HOST=litellm
LITELLM_PORT=4000
LITELLM_MODEL=gpt-4

# ================================
# LLM Configuration
# ================================
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
ANTHROPIC_MODEL=claude-3-opus-20240229
AZURE_OPENAI_ENDPOINT=https://your-azure-openai.openai.azure.com
AZURE_OPENAI_API_KEY=your-azure-openai-api-key
AZURE_OPENAI_DEPLOYMENT=gpt-4-deployment
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=30

# ================================
# Embedding Configuration
# ================================
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-ada-002
EMBEDDING_DIMENSION=1536
EMBEDDING_BATCH_SIZE=20
EMBEDDING_CACHE_ENABLED=true
EMBEDDING_CACHE_SIZE=10000
COHERE_API_KEY=your-cohere-api-key

# ================================
# Jira Configuration
# ================================
JIRA_URL=https://your-domain.atlassian.net
JIRA_USERNAME=your-jira-username@email.com
JIRA_API_TOKEN=your-jira-api-token
JIRA_PROJECT_KEY=SRE
JIRA_ISSUE_TYPE=Incident
JIRA_WEBHOOK_SECRET=your-jira-webhook-secret

# ================================
# Azure DevOps Configuration
# ================================
ADO_ORGANIZATION=your-organization
ADO_PROJECT=your-project
ADO_PAT=your-personal-access-token
ADO_PIPELINE_ID=1

# ================================
# Security Configuration
# ================================
API_KEY=your-api-key-for-client-auth
JWT_SECRET=your-jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
WEBHOOK_SIGNING_SECRET=your-webhook-signing-secret

# ================================
# Rate Limiting
# ================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60

# ================================
# Observability
# ================================
OTEL_ENABLED=true
OTEL_SERVICE_NAME=auto-sre-graph
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_EXPORTER_OTLP_INSECURE=true
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=Auto-SRE
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your-langchain-api-key

# ================================
# Feature Flags
# ================================
FEATURE_ENABLE_AUTO_REMEDIATION=false
FEATURE_ENABLE_LLM_CACHING=true
FEATURE_ENABLE_AUDIT_LOGGING=true
FEATURE_ENABLE_SLA_MONITORING=true
FEATURE_ENABLE_CANARY=true
FEATURE_ENABLE_COST_OPTIMIZATION=true

# ================================
# Timeouts
# ================================
CONTEXT_RETRIEVAL_TIMEOUT=30
AGENT_TIMEOUT=60
REMEDIATION_TIMEOUT=300

# ================================
# SLA Configuration
# ================================
SLA_RESPONSE_TIME_CRITICAL=120
SLA_RESPONSE_TIME_HIGH=300
SLA_RESPONSE_TIME_MEDIUM=600
SLA_RESOLUTION_TIME_CRITICAL=1800
SLA_RESOLUTION_TIME_HIGH=3600
SLA_RESOLUTION_TIME_MEDIUM=7200

# ================================
# Alert Filtering
# ================================
ALLOWED_SERVICES=auth-service,payment-service,order-service,user-service,notification-service,inventory-service
ALLOWED_ENVIRONMENTS=DEV,SIT,UAT,PROD
REQUIRE_STACK_TRACE=false

# ================================
# Cloud Providers (Optional)
# ================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AZURE_STORAGE_CONNECTION_STRING=
GCP_PROJECT_ID=
GCP_CREDENTIALS=

# ================================
# Slack Integration (Optional)
# ================================
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/slack/webhook
SLACK_CHANNEL=#sre-alerts

# ================================
# PagerDuty Integration (Optional)
# ================================
PAGERDUTY_API_KEY=your-pagerduty-api-key
PAGERDUTY_SERVICE_ID=your-pagerduty-service-id

# ================================
# pgAdmin (Optional)
# ================================
PGADMIN_EMAIL=admin@auto-sre-graph.com
PGADMIN_PASSWORD=admin